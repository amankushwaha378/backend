
@baseUrl = http://localhost:5000/api/auth

### 1. Request reset for an existing account
POST {{baseUrl}}/forgot-password
Content-Type: application/json

{
  "email": "kasis41197@herclan.com"
}


### 2. Request reset for a nonexistent account
POST {{baseUrl}}/forgot-password
Content-Type: application/json

{
  "email": "nonexistent-account@example.com"
}


### 3. Reject an invalid email
POST {{baseUrl}}/forgot-password
Content-Type: application/json

{
  "email": ""
}


### 4. Reset password with a placeholder token
### Replace the token with the real token from your email.
POST {{baseUrl}}/reset-password
Content-Type: application/json

{
  "token": "94538ba60a7abf0713d5a6d889aedd6bd531dbf990a31470905b2e8d4e4b17eb",
  "newPassword": "AmanMemighty!"
}


### 5. Reject a malformed token
POST {{baseUrl}}/reset-password
Content-Type: application/json

{
  "token": "invalid-token",
  "newPassword": "NewSecurePassword123!"
}


### 6. Reject a weak password
POST {{baseUrl}}/reset-password
Content-Type: application/json

{
  "token": "replace_with_the_64_character_token_from_the_email",
  "newPassword": "123"
}


### 7. Try to reuse a token after a successful reset
POST {{baseUrl}}/reset-password
Content-Type: application/json

{
  "token": "94538ba60a7abf0713d5a6d889aedd6bd531dbf990a31470905b2e8d4e4b17eb",
  "newPassword": "AnotherSecurePassword123!"
}
